<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.monicapass.monica.backup.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Monica</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>MonicaAppStoreID</key>
	<string></string>
	<!-- issue #66：Monica Plus 支持作者型非消耗商品的 App Store Connect 产品 ID。
	     必须与 App Store Connect 中真实存在的商品一致；留空表示当前版本不开放购买。
	     价格与名称由 StoreKit 的 displayPrice / displayName 提供，代码里不硬编码。 -->
	<key>MonicaPlusProductIDs</key>
	<array>
	</array>
	<key>GoogleDriveClientID</key>
	<string></string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Monica Send 加密分享包</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.monicapass.monica.send</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.monicapass.monica.send</string>
			<key>UTTypeDescription</key>
			<string>Monica Send 加密分享包</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>send</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.monicapass.send</string>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.monicapass.monica</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.com.monicapass.monica</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.monicapass.monica.shortcut</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>monica</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.monicapass.monica.otpauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>otpauth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>msauthv2</string>
		<string>msauthv3</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NFCReaderUsageDescription</key>
	<string>用于技术验证：读取 NFC 标签类型与系统选中的非支付应用标识，以评估银行卡贴卡读取能力。不会读取或保存卡号、有效期、CVV 等银行卡数据。</string>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>D2760000850100</string>
		<string>D2760000850101</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>用于扫描 TOTP 设置二维码。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于在同一个 Wi-Fi 或热点下发现并连接你自己发起的 Monica 设备，通过端到端加密在两台设备之间同步保险库条目。只会在你主动发起或加入同步时使用。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_monica-sync._tcp</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>用于解锁保险库，以及在开启生物识别解锁时验证你的身份。生物识别数据由系统处理，不会上传或存储。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>ASCredentialExchangeActivity</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
