    "正文引用的图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images Referenced in the Note"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正文引用的图片"
          }
        }
      }
    },
    "单张上限 %@，单条笔记最多 %lld 张。图片以加密附件存储，预览时才解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %@ per image and %lld images per note. Images are stored as encrypted attachments and decrypted only for preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单张上限 %@，单条笔记最多 %lld 张。图片以加密附件存储，预览时才解密。"
          }
        }
      }
    },
    "移除引用": {
      "localizations": {
