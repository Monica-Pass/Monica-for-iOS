            "value": "Default password manager"
          }
        }
      }
    },
    "Monica 自动填充": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Monica 自动填充"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monica AutoFill"
          }
        }
      }
    },
    "系统侧身份条目": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统侧身份条目"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System identity entries"
          }
        }
      }
    },
    "iOS 不允许 App 读取或设置「系统默认密码管理器」是谁，也不允许 App 监听其它 App 里出现的密码输入框。Monica 只能把自己注册为自动填充来源，是否启用由你在系统设置里决定。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许 App 读取或设置「系统默认密码管理器」是谁，也不允许 App 监听其它 App 里出现的密码输入框。Monica 只能把自己注册为自动填充来源，是否启用由你在系统设置里决定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS does not let an app read or set who the default password manager is, and does not let an app observe password fields in other apps. Monica can only register itself as an AutoFill source; whether it is enabled is up to you in iOS Settings."
          }
        }
      }
    },
    "设为自动填充来源": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为自动填充来源"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set as AutoFill source"
          }
        }
      }
    },
    "查看系统设置路径、测试步骤与 iOS 限制": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看系统设置路径、测试步骤与 iOS 限制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the settings path, test steps, and iOS limits"
          }
        }
      }
    },
    "自动填充守护": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动填充守护"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoFill guard"
          }
        }
