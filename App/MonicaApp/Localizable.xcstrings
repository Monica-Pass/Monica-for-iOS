            "state": "translated",
            "value": "Insights are computed on this device after unlock. While locked, this page shows no item details, score, or counts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁后会在本机完成统计。锁定状态下本页不显示任何条目信息、分数或命中数量。"
          }
        }
      }
    },
    "解锁后会在本机完成统计，数据不会离开设备。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights are computed on this device after unlock; data never leaves it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁后会在本机完成统计，数据不会离开设备。"
          }
        }
      }
    },
    "计算方式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it is calculated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算方式"
          }
        }
      }
    },
    "记录今天的快照": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record today’s snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录今天的快照"
          }
        }
      }
    },
    "评分 = 100 − 各分类扣分之和，每类扣分 = min(命中数 × 权重, 上限)。全部分析只在本机内存中完成。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score = 100 − the sum of category deductions, where each deduction = min(hits × weight, cap). All analysis happens in memory on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评分 = 100 − 各分类扣分之和，每类扣分 = min(命中数 × 权重, 上限)。全部分析只在本机内存中完成。"
          }
        }
      }
    },
    "距离上次更换已超过一年；没有修改记录的条目不计入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not changed for over a year; entries without a change record are not counted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离上次更换已超过一年；没有修改记录的条目不计入。"
          }
        }
      }
    },
    "还没有趋势数据。保持解锁并打开本页，每天会记录一个聚合快照（不含任何条目内容）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trend data yet. Keep the vault unlocked and open this page—one aggregate snapshot (no item content) is recorded each day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有趋势数据。保持解锁并打开本页，每天会记录一个聚合快照（不含任何条目内容）。"
          }
        }
      }
    },
    "这些条目在本机没有匹配的验证器条目，按本地规则推断为未开启 2FA。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These entries have no matching authenticator on this device, so local rules infer 2FA is not enabled."
